{
  "manifest_version": 2,
  "name": "MB apskaita – Deel helper",
  "version": "0.1.0",
  "description": "Step-by-step helper that collects Deel invoices (data + PDF) and sends them to mb.rezvart.com.",
  "permissions": [
    "storage",
    "tabs",
    "webRequest",
    "webRequestBlocking",
    "https://app.deel.com/*",
    "https://s3.eu-west-1.amazonaws.com/api-prod.letsdeel.com/*",
    "https://mb.rezvart.com/*"
  ],
  "background": { "scripts": ["background.js"] },
  "content_scripts": [
    { "matches": ["https://app.deel.com/*"], "js": ["content.js"], "run_at": "document_idle" }
  ],
  "sidebar_action": {
    "default_title": "MB Deel",
    "default_panel": "sidebar.html",
    "open_at_install": true
  },
  "browser_specific_settings": {
    "gecko": { "id": "mb-deel-helper@rezvart.com" }
  }
}
